[Unit]
Description=ClipVault cloud clipboard service
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/clipvault
Environment=BASE_URL=http://YOUR_SERVER_IP:3000
# 直连模式绑定 0.0.0.0:3000；不加 --proxy-headers（无反代时客户端 IP 即真实 IP，
# 信任 X-Forwarded-For 会让伪造头绕过限流）
ExecStart=/opt/clipvault/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 3000 --workers 2
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
